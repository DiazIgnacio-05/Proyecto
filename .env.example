# Copiá este archivo como .env y completá los valores. El .env NO se sube al repositorio.

# Base de datos (la usan docker-compose y la aplicación)
DB_USER=vidriera
DB_PASSWORD=cambiar-por-una-clave-larga
# DB_URL=jdbc:postgresql://localhost:5432/vidriera

# Dominio bajo el que viven los subdominios de los comercios (localhost en desarrollo)
VIDRIERA_DOMINIO_BASE=localhost

# Carpeta donde se guardan las fotos subidas desde el panel (por defecto ./uploads)
# VIDRIERA_IMAGENES_DIR=./uploads

# Super-admin que se crea al primer arranque (contraseña de 12+ caracteres)
SUPERADMIN_EMAIL=admin@vidriera.test
SUPERADMIN_PASSWORD=cambiar-por-una-clave-larga
