# Configuración de PRODUCCIÓN. En el servidor: cp .env.example .env y completar.
# El .env no se sube al repositorio. Generá claves largas, por ejemplo con: openssl rand -base64 24

# Base de datos
DB_USER=vidriera
DB_PASSWORD=

# Dominio de la plataforma: los comercios quedan en <slug>.<dominio> y el panel en app.<dominio>
VIDRIERA_DOMINIO_BASE=vidriera.com.ar

# Super-admin que se crea en el primer arranque (contraseña de 12+ caracteres)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Email para Let's Encrypt (avisos de certificados de los dominios propios)
ACME_EMAIL=

# Backups (deploy/backup.sh)
# Carpeta del servidor donde se guardan los backups
BACKUP_DIR=/var/backups/vidriera
# Copia fuera del servidor con rclone (remoto "r2" configurado con `rclone config`). Vacío = sin copia.
RCLONE_DESTINO=r2:vidriera-backups
